{
  "projectName": "OpenXenonLanguage",
  "languages": [
    {
      "id": "oxl",
      "grammar": "packages/engine/src/oxl/langium-driver/oxn.langium",
      "fileExtensions": [".oxn"],
      "textMate": {
        "out": "syntaxes/oxn.tmLanguage.json"
      },
      "chevrotainParserConfig": {
        "recoveryEnabled": true,
        "nodeLocationTracking": "full",
        "maxLookahead": 4
      }
    }
  ],
  "out": "packages/engine/src/oxl/langium-driver/generated/"
}
