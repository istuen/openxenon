probe "git-merge-feasible" align "GitMergeFeasible" {
  description = "判定 work 分支能否干净 merge 进 target_branch（用 git merge-tree 算法模拟，不实际 merge）"
  prop "workBranch"   { type = string; required = true }
  prop "targetBranch" { type = string; required = false; default = "current" }
  prop "cwd"          { type = string; required = false; default = "." }
  output {
    status       = string  // can_ff_merge | can_merge_clean | has_conflicts | dirty_worktree | unknown
    conflictFiles = list<string>
    targetCommit = string
    workCommit   = string
  }
}
