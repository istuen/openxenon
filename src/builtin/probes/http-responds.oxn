probe "http-responds" align "HttpResponds" {
  scheme = "http://"
  description = "HTTP 请求检查 status code（status === expectedStatus → PASS；默认 timeout 5s）"
  prop "url" { type = string; required = true }
  prop "method" { type = string; required = false; default = "GET" }
  prop "expectedStatus" { type = number; required = false; default = 200 }
  prop "timeout" { type = number; required = false; default = 5000 }
  prop "body" { type = string; required = false }
  prop "headers" { type = string; required = false }
  output { passed = boolean; status = number; ok = boolean; durationMs = number }
}
