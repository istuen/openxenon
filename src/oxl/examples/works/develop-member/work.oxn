// Work: develop-member
// 开发类工作流：实现会员功能

work "develop-member" {
  context {
    goal = "实现新会员注册功能";
    constraints = [
      "必须使用 MemberContext 的 term.Member，不能用 User/Customer",
      "密码必须 hash 后存储"
    ];
    loop_policy {
      max_iterations = 5;
    }
  }

  domain "MemberContext" ref "@prj/domains/member-context";
  blueprint "dev-workflow" ref "@prj/blueprints/dev-workflow";

  task "register-member" {
    domain "MemberContext";
    blueprint "dev-workflow";

    part "develop" {
      skill_context = "实现 Member 注册功能";
    }

    deps = [];
  }
}
