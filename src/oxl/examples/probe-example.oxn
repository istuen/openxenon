probe "shell_exec" align "ShellExec" {
  description = "执行 shell 命令并返回结果"
  prop "command" { type = string; required = true }
  output { exit_code = number; stdout = string; stderr = string }
}

probe "fs-exists" align "FsExists" {
  description = "检查指定 glob 模式的文件是否存在"
  prop "pattern" { type = string; required = true }
  output { exists = boolean }
}