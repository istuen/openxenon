{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OXN Bundle Assembly Schema",
  "type": "object",
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
