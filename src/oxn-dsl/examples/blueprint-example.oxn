blueprint "oxn-example" kind task {
  description = "示例 Blueprint，展示 Intent-Align DSL 语法"

  version = 1
  prop "env" { type = string; default = "dev" }

  slot "build" intent "Build" {
    deps = []
  }

  slot "develop" intent "Code" {
    deps = [slot.build]
  }

  slot "test" intent "Test" {
    deps = [slot.build]
    observe "ShellExec"
  }

  stage "build-stage" run slot.build { deps = [] }
  stage "dev-stage" run slot.develop { deps = [stage.build-stage] }
  stage "test-stage" run slot.test { deps = [stage.build-stage] }

  expectation "must-pass-tests" {
    probe = "@oxn/probes/shell_exec"
    params = { command = "npm test" }
    err_msg = "测试必须通过才能提交"
  }

  rule "prod_requires_ha" {
    condition = prop.env != "prod"
    err_msg = "生产环境必须开启 HA"
  }
}