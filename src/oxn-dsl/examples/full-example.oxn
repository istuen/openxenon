probe "fs-exists" {
  description = "验证文件是否存在"
  prop "path" { type = string; required = true }
  prop "recursive" { type = boolean; default = false }
  output { exists = boolean }
}

part "jest-runner" {
  description = "Jest 测试执行器"
  prop "target_env" { type = string; default = "dev" }
  prop "coverage_threshold" { type = number; default = 80 }
  probe run_tests ref "@oxn/probes/shell-exec" {
    params = {
      command = "npm test -- --coverageThreshold=${prop.coverage_threshold}",
      timeout = 60000
    }
  }
  execution = [run_tests]
}

blueprint "feature-pipeline" {
  version = 1
  prop "env" { type = enum("dev", "staging", "prod"); default = "dev" }
  prop "coverage" { type = number; default = 80 }

  slot "test" {
    run = "slot.test.run"
  }

  stage "unit_test" {
    run = "slot.test.run"
  }

  expectation "must_use_zod" {
    probe = "@oxn/probes/ts-uses-import"
    params = { file_pattern = "src/api/**/*.ts", module_name = "zod" }
    err_msg = "API 层代码违反规范"
  }

  rule "prod_requires_ha" {
    condition = prop.env != "prod" || prop.coverage == 95
    err_msg = "生产环境必须强制开启高可用"
  }
}

task "validate-feature-auth" use "@prj/blueprints/feature-pipeline" {
  part slot "test" ref "@prj/parts/jest-runner" {
    prop target_env = "prod"
  }
}
