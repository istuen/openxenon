probe "fs-exists" {
  description = "检查指定 glob 模式的文件是否存在"
  prop "pattern" { type = string; required = true }
}

probe "fs-not-exists" {
  description = "检查指定 glob 模式的文件是否不存在"
  prop "pattern" { type = string; required = true }
}

probe "fs-content-match" {
  description = "检查文件内容是否匹配指定模式"
  prop "path" { type = string; required = true }
  prop "contains" { type = string; required = true }
}

probe "exec-exit-zero" {
  description = "检查 Shell 命令执行退出码是否为 0"
  prop "command" { type = string; required = true }
  prop "cwd" { type = string; required = false; default = "." }
}
