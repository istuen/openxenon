{
  "name": "oxl",
  "scopeName": "source.oxl",
  "fileTypes": [
    ".oxn"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "name": "keyword.control.oxl",
      "match": "\\b(acceptance|align|any|as|ban|blueprint|boolean|constraints|context|default|deps|description|domain|enum|execution|false|goal|guidance|invariant|lifecycle|list|loop_policy|map|max_iterations|null|number|objective|observe|output|param|params|part|parts|probe|proof|prop|ref|required|scheme|skill|skill_context|slot|string|task|term|true|type|version|work)\\b"
    },
    {
      "name": "string.quoted.double.oxl",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#string-character-escape"
        }
      ]
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.oxl",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.oxl"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.oxl"
            }
          }
        },
        {
          "begin": "//",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.oxl"
            }
          },
          "end": "(?=$)",
          "name": "comment.line.oxl"
        }
      ]
    },
    "string-character-escape": {
      "name": "constant.character.escape.oxl",
      "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\\{[0-9A-Fa-f]+\\}|[0-2][0-7]{0,2}|3[0-6][0-7]?|37[0-7]?|[4-7][0-7]?|.|$)"
    }
  }
}
