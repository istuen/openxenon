// Blueprint: dsl-evolve — Generated by oxn sync-md v0.4 Phase 2
// synced at: 2026-06-26T01:19:20.246Z

blueprint "dsl-evolve" {
  version = 1
  description = "OXL 演进流程：提出语法变更 → 迁移 example → 重新生成 generated/ → 全量验证（lint+typecheck+test）"
  prop "langium_source" { type = string; default = "src/oxl/langium/oxn.langium" }
  prop "examples_dir" { type = string; default = "src/oxl/examples" }

  slot "propose-grammar" {
    observe = ["fs-exists", "fs-parseable"]
  }
  slot "migrate-examples" {
    deps = ["propose-grammar"]
    observe = ["fs-content-match"]
  }
  slot "regen-generated" {
    deps = ["migrate-examples"]
    observe = ["shell-exec"]
  }
  slot "verify" {
    deps = ["regen-generated"]
    observe = ["lint-check", "ts-compiles", "test-pass"]
  }
}
