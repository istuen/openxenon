// Blueprint: asset-create
// Created by: oxn asset create asset-create --kind blueprint
// Work: asset-skill-assets (stage-2)
//
// Asset 创建执行路径 (oxn-asset Skill 步骤 1-3):
//   choose-kind (选 6 AssetKind)
//     -> fork-template (从 assets/{kind}.md 模板 fork)
//        -> fill-content (按模板 H2 填内容)
//           -> validate-commit (oxn asset validate + chmod 444 + add to git)

blueprint "asset-create" {
  description = "Asset 创建流水线: choose-kind → fork-template → fill-content → validate-commit"
  assetVersion = 1
  slot "choose-kind" { deps = [] }
  slot "fork-template" { deps = ["choose-kind"] }
  slot "fill-content" { deps = ["fork-template"] }
  slot "validate-commit" { deps = ["fill-content"] }
}
