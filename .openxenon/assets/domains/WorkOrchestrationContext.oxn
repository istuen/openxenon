// Domain: WorkOrchestrationContext — Generated by oxn work create v0.6.1-alpha.1
// synced at: 2026-07-08T08:27:21.830Z

domain "WorkOrchestrationContext" {
  description = "Work v1.1 8 阶段编排限界上下文: init->migrate->create->add-task->validate->lock->run->submit 闭环;5 workType (task/explore/edit 一等 mode + workspace 兑底 + asset 独立路径) 决定 work 编排风格;PlanLock 4 组件 hash 守卫 + BirthCert 静态门禁卡"

  term {
    "WorkV1": "v1.1 引入的 Work 沙盒布局: works/<w>/work.oxn + .work (静态卡) + .run/ (运行时);V0 布局需先 migrate"
    "Phase": "8 阶段流程的一个阶段: init/migrate/create/add-task/validate/lock/run/submit;按顺序不可跳"
    "Init": "oxn work init: 创建 .openxenon/ 边界 + ProjectConfig;不创建 work"
    "Migrate": "oxn work migrate: V0 布局 (works/<w>/*.oxn 散文件) -> V1 布局 (works/<w>/{work.oxn, .work, .run/});复制 + 备份到 .migrated-v0/"
    "Create": "oxn work create <w> --type <X>: 写 work.oxn 骨架;X ∈ {task, explore, edit, workspace, asset};5 个 workType 中 task/explore/edit 为一等 mode,workspace 兑底 mode=task+warning,asset 走独立 handleAssetModeCreate"
    "AddTask": "oxn work add-task --work <w> --task-name <t> --blueprint <bp> [--domain <d>]: 写 tasks/<t>/task.oxn 内联到 work.oxn"
    "Validate": "oxn work validate <w>: 校验 work.oxn 语法 + task DAG 无环 + asset 引用存在;通过后写 .work (BirthCert)"
    "Lock": "oxn work lock <w>: 算 4 组件 hash 写入 .work.planLock;锁后任何漂移 = IAP_ALIGN_LOCK_HASH_MISMATCH"
    "Run": "oxn work run --work-file <work.oxn>: 启动状态机;落 .run/state.json + trace.jsonl;Probe FAIL 触发 Daemon 逃逸"
    "Submit": "oxn work submit --work-name <w> --task <t>: 推进 task 内 part 状态;通过 Probe -> 写 frozen.json (PROOF verdict)"
    "WorkType": "CLI --type 接受的 5 个字符串枚举: task (默认) / explore / edit / workspace / asset;其中 task/explore/edit 是一等 mode (WorkModeSchema z.enum),workspace 是扩展 (兑底 mode=task+warning),asset 走独立 handleAssetModeCreate 路径不走 workTypeToMode"
    "WorkMode": "Work 一等 mode 枚举 (WorkModeSchema z.enum): task | explore | edit;CLI 默认 task;workTypeToMode 只识别 3 个一等, 其他兑底 task + warning;BirthCert.mode 字段恒为 3 选 1"
    "AssetModeShortCircuit": "workType=asset 走 handleAssetModeCreate 独立分支, 不调 workTypeToMode, 不写 .work/.run, 只写 .openxenon/assets/{kinds}/{name}.oxn + .md 镜像 (PR-3 翻转);必填 --asset-kind X 之一 (domain/blueprint/stack/library/external)"
    "WorkTypeFallback": "未知 workType 走 workTypeToMode 兑底: mode='task' + warning 'unknown workType X -> mode fallback to task';birth-cert.ts 3 enum 严格验证, 写入 BirthCert.mode 恒合法"
    "BirthCert": "Work .work 静态门禁卡: planLock (4 hash) + assets (域/蓝图 fileHash) + context (goal/constraints/maxIterations) + diagnostics;写一次后只读"
    "PlanLock": "BirthCert 内不可变快照: workOxnHash + workDomainsHash + blueprintsHash + tasksHash + allHash;锁后任何漂移 = LOCK_HASH_MISMATCH"
    "DAG": "Work 内 task 依赖图;无环 (Kahn's algorithm 校验, 含 cycleHint 提示);V0 layout 隐式依赖 name 引用,V1 显式 deps=['a','b']"
    "RefPool": "Work 级声明的 domain/blueprint/part/probe ref 池;Task 只能从 RefPool inject;不可直接 import 资产"
    "MigratedV0Dir": "V0 备份目录: .migrated-v0/<w>/;OXN 不自动清,工程师手动清理;供审计可恢复"
  }

  ban { "WorkV0Layout", "V0Bypass", "BypassLock", "BypassValidate", "BypassMigrate", "oxn-work-new", "oxn-work-task-create", "PhaseSkip", "DirectSubmit", "UnlockedRun", "InlineAsset", "oxn work new", "oxn work task create", "auto-promote-work", "WorkTypeDevelop", "WorkTypeFix", "WorkTypeOnboarding", "WorkTypeOnboard", "develop-mode", "fix-mode", "onboarding-mode" }

  invariant {
    "8 阶段顺序不可跳: init -> migrate -> create -> add-task -> validate -> lock -> run -> submit;违反 -> IAPError 拒绝"
    "--type 接受 5 个 workType 字符串: task (默认, 一等 mode=task) / explore (一等 mode=explore) / edit (一等 mode=edit) / workspace (扩展, 兑底 mode=task+warning) / asset (走 handleAssetModeCreate 独立分支, 不参与 workTypeToMode, 必填 --asset-kind X)"
    "workTypeToMode 只识别 3 个一等: task/explore/edit;workspace/未知字符串兑底 mode=task+warning 'unknown workType X -> mode fallback to task';BirthCert.mode 字段恒为 3 选 1 (WorkModeSchema z.enum 严格验证)"
    "Asset 模式 (--type asset --asset-kind X) 走 handleAssetModeCreate: 不调 workTypeToMode, 不写 .work/.run, 只写 .openxenon/assets/{kinds}/{name}.oxn + PR-3 sync 补 .md 镜像;X ∈ {domain, blueprint, stack, library, external}"
    "AI 禁止使用历史错名 workType: develop / fix / onboarding;CLI 仍接受 (兑底 task+warning),但 Domain 业务词汇锁定 5 个正确 workType 名 (term WorkType ban: WorkTypeDevelop/Fix/Onboarding/Onboard)"
    "validate 成功前不能 lock: 缺 .work.planLock -> IAP_ALIGN_LOCK_NOT_FOUND (YIELD_TO_HUMAN)"
    "lock 成功前不能 run: 缺 planLock -> 拒绝启动;unlock 状态可 run 但不写 .run/state.json"
    "run 成功后才能 submit: 缺 .run/state.json -> IAP_ALIGN_WORK_NOT_RUNNING (YIELD_TO_HUMAN)"
    "PlanLock 4 组件 hash 必一致: workOxn / workDomains / blueprints / tasks 之一漂移 -> IAP_ALIGN_LOCK_HASH_MISMATCH"
    "lock 后任何 .oxn 资产漂移 (域/蓝图/work.oxn/task.oxn 之一) -> 立即 LOCK_HASH_MISMATCH 阻断"
    "work.oxn 失踪但 .work 还在 -> IAP_ALIGN_WORK_REMOVED (v1.1 引入, 区别于 WORK_NOT_FOUND)"
    "Asset 模式 (--type asset --asset-kind X) 不走 task DAG;只写 .openxenon/assets/{kinds}/{name}.oxn;无 .work/.run"
    "V0 布局必须先 oxn work migrate 才能走 lock 守卫;V0 直接 run -> IAP_ALIGN_V0_LEGACY_BLOCKED"
    "MigratedV0Dir 保留 V0 备份供审计;OXN 不自动清,工程师手动清理 (避免误删导致不可恢复)"
    "Work 引用 Asset 用 domain X ref @prj/{dir}/{name};@prj 寻址必须实际存在 (CLI 加载期 fail-fast)"
    "Task 内 Part 名必须对齐 Blueprint Slot 名;不对齐 -> work run 时找不到对齐目标 (DEP_NOT_FOUND)"
    "Work 内 task DAG 必须无环 (Kahn's algorithm 校验);有环 -> IAP_INTENT_DAG_CYCLE (YIELD_TO_HUMAN, 含 cycleHint)"
    "Asset 模式不接受 --blueprint/--domain/--slots;Asset 是单一资产,不是 task 编排"
    "oxn work run --work-file 必填;oxn work submit --work-name + --task 必填;少参数 -> OXN_CLI_INPUT_ERROR"
    "oxn work new 已在 v1.0 移除;CLI 拒绝 unknown command 'new' (不能是别名);统一用 oxn work create"
  }

}
