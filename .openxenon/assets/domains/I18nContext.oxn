// Domain: I18nContext — Generated by oxn work create v0.6.1-alpha.1
// synced at: 2026-07-08T08:27:21.830Z

domain "I18nContext" {
  description = "i18n 国际化限界上下文: zh-CN/en 双语 + locale 协议 + t() 翻译函数 + resolveLocale 解析;config.locale (ProjectConfig) 是唯一权威 locale 源;CLI 默认 human 模式按 locale 选文案"

  term {
    "Locale": "语言区域标识;SupportedLocale = 'zh-CN' | 'en';CLI 顶层 + Skill + 文档站点共用"
    "ZhCN": "简体中文: 唯一权威 locale,所有 SSOT 文案首发;en locale 内容与 zh-CN 保持一致 (不允许独立维护)"
    "En": "英文 locale: v0.6 起已废弃,沿用 zh-CN 内容 (不允许独立维护);保留 enum 仅为兼容旧 config.locale='en' 用户"
    "I18nKey": "翻译 key 字符串: 'domain.list.description' / 'format.json' / 'error.asset.create.failed';点号分隔命名空间"
    "TFunction": "t(key, args?): 主翻译函数;从 t('domain.list.description', {count: 5}) 解析当前 locale 字符串;缺 key 抛 I18N_KEY_MISSING (YIELD_TO_HUMAN)"
    "ResolveLocale": "resolveLocale(config, env?): 解析当前生效 locale;优先级: --locale flag > config.locale > LANG env > DEFAULT ('zh-CN')"
    "DefaultLocale": "DEFAULT_LOCALE = 'zh-CN';CLI 启动 + Skill 加载 + 文档站点全用此值兜底"
    "LocaleBundle": "locale 字典: { [key: string]: string } 平面结构;不存在嵌套;按 dot key 索引"
    "TranslationArgs": "t(key, args) 第二参数: {name?: string; count?: number; ...};占位符 {{name}} 双花括号替换"
    "ConfigLocale": "ProjectConfig.locale 字段;gitignored (个人运行时);CLI 加载期 readProjectConfig 解析"
    "LocaleFallback": "t() 缺 key 时的兜底: 静默返回 key 字符串 (CLI human 模式) 或抛 I18N_KEY_MISSING (--strict 模式)"
    "I18nNamespace": "I18nKey 第一段前缀: 'domain.' / 'blueprint.' / 'work.' / 'format.' / 'error.' / 'cli.';按 CLI 子命令分组"
    "SkillLocale": "Skill 的语言变体: packages/cli/src/skills/locales/{zh-CN,en}/<skill-id>/SKILL.md;zh-CN 是唯一权威"
    "DocLocale": "VitePress 文档站点的 i18n: docs/zh-cn/*.md (首发) + docs/en/*.md (镜像);zh-cn 是 SSOT"
    "LocaleAudit": "审计工具: 扫 CLI t() 调用 + 字典缺失 key + 多余 key;CI 守门,缺失/多余都报"
  }

  ban { "hardcodedString", "englishFallback", "i18n.bypass", "t.bypass", "stringLiteralAsI18n", "locale.en-only", "locale.legacy-iso-code" }

  invariant {
    "DEFAULT_LOCALE = 'zh-CN' 是唯一权威兜底;CLI / Skill / 文档站点全用此值"
    "en locale 已废弃: config.locale='en' 仍能跑 (兼容),但文案与 zh-CN 一致;禁止独立维护 en 文案"
    "t(key) key 必须存在于 zh-CN locale 字典;缺失 → 抛 I18N_KEY_MISSING (YIELD_TO_HUMAN, 防止静默 fallback 掩盖 bug)"
    "t(key) 占位符 {{name}} 双花括号;不允许 %s / ${} / {} 等历史占位符"
    "resolveLocale 优先级: --locale flag > config.locale > LANG env > DEFAULT ('zh-CN');同优先级后者覆盖前者"
    "I18nKey 第一段命名空间: domain./blueprint./work./format./error./cli.;新增命名空间必须更新 I18nNamespace 字典"
    "config.locale (ProjectConfig) 是运行时唯一权威;不允许从 process.env.LANG 直接读 (绕过 config)"
    "t() 缺 key 行为: 默认 human 模式静默返回 key + 打印 stderr warn; --strict 模式抛 I18N_KEY_MISSING 阻断"
    "CLI human 模式输出必须走 t();不允许 process.stdout.write('') 内联英文/中文;违反 → biome lint 拒绝"
    "LocaleBundle 是平面结构 {key: string};嵌套对象违反 → locale-loader 拒绝加载"
    "Skill 内的 command description / 文案引用必须走 t() 或包内字面量;不允许 'inline english string'"
    "zh-CN locale 字典是 SSOT;en locale 通过 autoMirror 镜像 (CLI init 时自动生成);不允许手写 en 字典"
    "LocaleAudit CI 守门: zh-CN key 数 - en key 数 = 0 (否则 fail);新增 zh-CN key 必须同步 en (即使 en 镜像)"
    "硬编码字符串 (process.stdout.write('Hello')) 在 CLI 入口 (citty command) 描述中禁止;必须走 t()"
    "OXN 不引入 i18next / react-intl / lingui 等第三方 i18n 库;自实现 t() + locale bundle 足够 (locales/{zh-CN,en}.json)"
  }

}
