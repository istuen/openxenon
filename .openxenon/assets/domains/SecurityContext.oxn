// Domain: SecurityContext — Generated by oxn sync-md v0.4 Phase 2
// synced at: 2026-06-26T01:19:20.016Z

domain "SecurityContext" {
  description = "源代码侧的安全防护限界上下文：ReDoS 防护、Shell 注入拦截、路径穿越防御、资源超时保护"

  term {
    "ReDoS": "正则表达式拒绝服务：恶意模式如 (a+)+b 在长输入下指数级回溯，进程挂死"
    "ShellInjection": "Shell 元字符未转义导致命令拼接: ; | & $() ` 等被攻击者利用"
    "PathTraversal": "用户传入路径含 ../ 逃逸沙盒边界，写入或读取非授权目录"
    "SafeRegex": "safe-regex 库提供的复杂度上限校验：max safe length < 输入长度 即拒"
    "ArgvArray": "spawn(cmd, [arg1, arg2]) 形式：参数作为 argv 数组传递，不经 shell 解析"
    "Boundary": "沙盒根目录绝对路径，所有用户路径必须 resolve 后在 boundary 之内"
    "Timeout": "外部命令最大执行毫秒数，超时由 setTimeout + kill 实现"
    "ShellEscape": "对必须 shell 调用的场景，参数中 ; | & $() ` 替换为转义形式"
  }

  ban { "shell: true", "child_process.exec" }

  invariant {
    "用户输入的 regex 模式必须先经 safe-regex 校验（max safe length < 10^5）"
    "spawn 调用必须传 argv 数组，禁止 shell:true 形式（避免元字符被 shell 解析）"
    "所有用户 filePath 必须经 path.resolve + boundary.startsWith 检查"
    "外部命令（shell-exec / process.exec）必须有 timeout，默认 30 秒"
    "正则匹配必须有 timeout 或次数上限（避免 O(2^n) 回溯）"
    "socket 监听必须有 max connection 上限 + 读超时"
  }

}
