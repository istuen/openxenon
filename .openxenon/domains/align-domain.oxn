// Domain: AlignDomain
// Align 轴统一词汇（v0.1 重组版）— 由原 work-context / skill-context / intent-align Align 段合并而来
//
// 物理边界（IAP 范式）：
//   - 本域是「AI 主导的 Align 轴」在 .openxenon/ 下的统一入口
//   - 编排：.openxenon/works/<work>/work.oxn
//   - 执行单元：.openxenon/works/<work>/tasks/<t>/task.oxn
//   - 与 intent-domain.oxn（Intent 轴）通过 context_map 显式连接，不互相 include
//   - 与 proof-domain.oxn（Proof 轴）通过 frozen.json 汇合
//
// 重组前 → 重组后：
//   - work-context.oxn        → AlignDomain "Work/Task/Artifact/Snapshot/Frozen/Trace" + v1.1 Lock 守卫
//   - skill-context.oxn       → AlignDomain "Skill/Instruction/ReferenceFile/Locale/InstallTarget"
//   - intent-align-context.oxn Align 段 → AlignDomain "Align/Slot/Part/Probe/RefPool/SkillContext"

domain "AlignDomain" {
  description = "Align 轴统一词汇：Work 沙盒生命周期 + Skill 安装分发 + IAP Align 段（Slot/Part/Probe/RefPool）的合并域"

  // ====================================================================
  // 术语（term 块单数：Work 17 + Skill 7 + Align 6 = 30 个）
  // ====================================================================

  term {
    // ───────── Work 沙盒（来自 work-context.oxn）─────────
    "Work":         "一次任务执行的沙盒，绑定一份 Blueprint"
    "Task":         "Work 内的具体步骤，对齐 Blueprint 的某个 slot"
    "Artifact":     "Work 执行产生的物理产物，被 Probe 观测的对象"
    "Snapshot":     "某一时刻 Work 状态的不可变快照"
    "Frozen":       "验证通过后生成的判决书（frozen.json）"
    "Trace":        "Work 执行轨迹，JSONL 追加式事件流"
    "PartExecution":"单个 part 的执行记录（含 probe 结果）"

    // v1.1 Lock 边界守卫
    "BirthCert":    "Work 的 .work 静态门禁卡：planLock + assets + context（goal/constraints/maxIterations）+ diagnostics；写一次后只读"
    "PlanLock":     "BirthCert 内不可变快照：4 组件 hash（workOxn / workDomains / blueprints / tasks）+ allHash；锁后任何漂移 = LOCK_HASH_MISMATCH"
    "AssetHash":    "域/蓝图文件的 SHA-256（64-hex）：OXN 启动期算并存入 BirthCert.assets；validate 时重算，lock 时锁定"
    "WorkLayoutV0": "V0 布局：works/<w>/work-state.json + tasks/<t>/task-state.json（无 .run/ 目录）"
    "WorkLayoutV1": "V1 布局：works/<w>/.run/{state,trace,frozen}.{json,jsonl} + tasks/<t>/{state,trace,frozen}（PR-4+5 落地）"
    "MigratedV0Dir":"迁移备份目录：.migrated-v0/<rel> 保留 V0 原文件供审计；不删不自动清，留工程师手动清理"

    // PR-14 Diagnostics 软警告
    "Diagnostics":          "data.diagnostics 字段（context / run / migrate / status 响应）—— 软警告命名空间，与 IAPError 物理隔离"
    "RefDiagnostic":        "Diagnostics 单元素：{code, severity, ref, type, message, suggestion}；code 用 OXN_WORK_REFS_* CLI 协议字符串（非 IAP_<AXIS>_*）"
    "RefDiagnosticSeverity":"RefDiagnostic.severity 枚举：warn（软警告，可继续执行）/ error（保留供未来 in-flight 错误，当前未使用）"
    "RefDiagnosticType":    "RefDiagnostic.type 枚举：domain / blueprint；按域/蓝图分别构建"

    // ───────── OpenCode Skills（来自 skill-context.oxn，7）─────────
    "Skill":         "一份面向 AI 的结构化指令单元（id + description + instruction + references），落地为 .opencode/skills/<id>/SKILL.md"
    "Instruction":   "Skill 的主指令 markdown 正文（AI 第一句要读的内容）"
    "ReferenceFile": "Skill 的次级 markdown 引用文件，存放在 .opencode/skills/<id>/references/，按需加载"
    "SkillMeta":     "Skill 的元信息（id + description），用于 OpenCode 的 skill 索引与自动选择"
    "Locale":        "Skill 的语言变体；当前唯一权威为 zh-CN，en 已废弃（沿用 zh-CN 内容）"
    "EmbeddedSkill": "编译进 binary 的 Skill 内容（Bun 的 with { type: 'file' } 导入），保证 oxn install-skill 在任意 CWD 下都能工作"
    "InstallTarget": "Skill 安装的目标目录，默认 ~/.opencode/skills/，可由 --target 覆盖"

    // ───────── IAP Align 段（来自 intent-align-context.oxn Align 部分，6）─────────
    "Align":        "把 Intent 展开为可执行路径的过程：编排 + 选件 + 设验"
    "Slot":         "Blueprint 内拓扑节点；Task 内 Part 的对齐目标（part 名对齐 slot 名）"
    "Part":         "Task 内 skill 执行单元（skill_context + acceptance），不独立成文件"
    "Probe":        "物理观测单元（prop 输入 + output 判定），不独立成文件，内联在 part 内"
    "RefPool":      "Work 级声明的 domain/blueprint/part/probe ref 池，Task 只能从中 inject"
    "SkillContext": "AI 可见的目标/约束/当前焦点（work.context + task.context + part.skill_context 三层）"
  }

  // ====================================================================
  // 禁词（ban 块单数：Work 5 + Skill 11 = 16 个）
  // ====================================================================

  ban {
    // Work 沙盒
    "Job", "TaskRun", "Execution", "Pipeline", "VerdictAsException",
    // OpenCode Skills
    "Plugin", "Extension", "Hook", "PromptTemplate",
    "oxn-task", "oxn-explore", "oxn-plan", "oxn-leader",
    "oxn-arsenal", "oxn-forge", "oxn-global", "oxn-add-probe",
    "oxn-resume"
  }

  // ====================================================================
  // 不变量
  // ====================================================================

  // ───────── Work 沙盒 ─────────
  invariant { "Work 的运行时类型必须与 Blueprint.type 强一致" }
  invariant { "frozen.json 生成后不可修改（仅可读取作为判决书）" }
  invariant { "work-trace.jsonl 只能追加写，不能重写" }
  invariant { "同一 part 只能被提交一次，重复 submit 必须基于 freeze 重建" }
  invariant { "Artifact 路径必须落在 Work 沙盒内或宿主项目目录" }
  invariant { "Work 必须经过 validate → lock 才能 run/context；锁状态在 .work.planLock 静态卡中" }
  invariant { "lock 后任何 .oxn 资产漂移（域/蓝图文件改了、work.oxn 改了、task.oxn 改了）→ LOCK_HASH_MISMATCH" }
  invariant { "PR-14 修复错位 fail-fast：域/蓝图 ref 缺失走 diagnostics 软警告（不硬失败），lock 守卫仍是硬失败" }
  invariant { "PR-14 diagnostics 持久化到 .run/state.json.diagnostics（severity 必为 warn）—— 可审计、可被未来 Daemon 消费" }
  invariant { "Work 必须存在 .run/state.json（V1 布局）；V0 布局必须先 oxn work migrate 才能走 lock 守卫" }
  invariant { "MigratedV0Dir 保留 V0 备份供审计；OXN 不自动清，工程师手动清理" }

  // ───────── OpenCode Skills ─────────
  invariant { "Skill ID 必须以 'oxn-' 前缀开头（如 oxn-cli、oxn-work），避免与第三方 skill 冲突" }
  invariant { "zh-CN 是唯一权威 Locale；en Locale 已废弃，必须与 zh-CN 内容保持一致（不允许独立维护）" }
  invariant { "Skill 名 ↔ 目录 1:1 映射：.opencode/skills/<id>/ 必须存在且含 SKILL.md" }
  invariant { "install-skill 写入路径必须为 ~/.opencode/skills/<id>/SKILL.md（或 --target 指定路径），不可写到其他位置" }
  invariant { "SKILL.md 嵌入 binary 后必须经 install-skill 才能落到目标目录；不允许运行时从源端直接加载" }
  invariant { "Skill 内的命令引用必须与 CLI 实际子命令一致；v0.0.x 已删除命令（oxn task *、oxn leader *、oxn arsenal *、oxn add-probe、oxn get-context、oxn work new）一律不能在 Skill 中出现" }
  invariant { "Skill 内禁止使用 'new' 子命令；统一改为 'create'（oxn work create / oxn domain create / oxn blueprint create）" }
  invariant { "Part / Probe 没有 CLI 入口；Skill 内禁止 'oxn part new' / 'oxn probe new' 等不存在的命令，必须教 AI 内联写" }

  // ───────── IAP Align 段 ─────────
  invariant { "Align 资产（Work/Task）只能通过 oxn work add-task / task-edit / task-delete 受控微调；其他改动走 $EDITOR 改 work.oxn / task.oxn" }
  invariant { "Part / Probe 不允许作为独立 .oxn 文件存在，必须内联在 task.oxn 的 part { probe { } } 块内" }
  invariant { "Task 必须 align 至少 1 个 Blueprint（fail-fast，缺少时 DSL 拒绝）" }
  invariant { "Task 内 Part 名必须对齐 Blueprint Slot 名，否则 work run 时找不到对齐目标" }
  invariant { "Work 内 task DAG 必须无环（Kahn's algorithm 校验，含 cycleHint 提示）" }
  invariant { "Task 引用了未声明的 dep 或 task 名重复 → DSL 拒绝（intent-align-validator 拦截）" }
  invariant { "work.oxn 引用的 domain/blueprint ref 必须实际存在于 .openxenon/ 下（CLI 加载期 fail-fast 拦截）" }
  invariant { "Slot DAG 不允许自环（slot a 的 deps 里不能含 a 自身）" }
  invariant { "Probe 标准必须来自 Blueprint 的 observe 数组（Intent 轴），不能由 Align 轴运行时追加" }

  // ───────── 跨域分工（与 intent / proof / L0L3 的边界）─────────
  invariant { "本域是 Align 轴专属词；Intent 轴词汇（CLI/DSL/Program）见 intent-domain.oxn" }
  invariant { "Proof 轴专属词（Probe/Frozen/Verdict/Runtime 模块）见 proof-domain.oxn" }
  invariant { "本域与 L0L3Context.oxn 正交：本域约束业务 Align 词汇，L0L3 约束代码分层" }
}
