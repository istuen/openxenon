// Domain: ProgramContext
// P1 builtin Domain — Language-agnostic programming vocabulary
// 服务 6 个 P1 Probes（5b 阶段实现）：
//   test-pass → TestCase
//   deps-resolved → Package
//   ts-compiles → SourceFile
//   lint-check → SourceFile
//   http-responds → APIEndpoint
//   file-exports → Module
//
// 此 Domain 放在 .openxenon/domains/ 下，作为 openxenon 项目自身的 P1 域参考。
// 用户在自己项目用时，可通过 oxn domain create 复制并扩展。

domain "ProgramContext" {
  description = "P1 builtin Domain — 语言无关的编程概念词汇表（Service 6 P1 Probes）"

  term {
    "SourceFile":     "项目里的 .ts/.js/.tsx/.jsx 源文件"
    "Module":         "有具名 exports 的源文件（运行时真相 = 实际导出列表）"
    "TestCase":       "*.test.ts 里的单个 test(name, fn) 调用"
    "Package":        "package.json 里的 dependencies / devDependencies 项"
    "BuildArtifact":  "tsc / bun build 生成的 dist/ 产物（V2 future）"
    "APIEndpoint":    "HTTP URL pattern + method（GET/POST/...）"
  }

  ban {
    "image-only-asset",
    "absoluteFileURL",
    "var",
    "document.",
    "window."
  }

  invariant { "6 个 term 与 6 个 P1 Probes 一一对应（test-pass/TestCase 等）" }
  invariant { "Probe 名以 kebab-case 暴露给 AI（如 test-pass），内部以 snake_case 注册（如 test_pass）" }
  invariant { "test-pass 复用 shell-exec 内部 API（DRY：probe 不重复 spawn 逻辑）" }
  invariant { "deps-resolved 优先解析 bun.lock，失败 fallback package.json 即可" }
  invariant { "http-responds 默认 timeout 5s（防止 AI 触发真实网络挂起）" }
  invariant { "file-exports 默认在子进程跑（防止顶层副作用污染主进程）" }
}
