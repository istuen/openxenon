// Domain: CLIContext
// CLI 入口限界上下文：管理 SubCommand / Arg / OutputFormat / 错误码

domain "CLIContext" {
  description = "CLI 入口限界上下文：管理子命令、参数、输出格式、错误码"

  term {
    "Command": "CLI 顶级命令（init/work/leader/blueprint/domain/...）"
    "SubCommand": "命令的子命令（如 work task new）"
    "Arg": "命令参数（必填或可选）"
    "OutputFormat": "输出格式（human/json/yaml/html/md）"
    "ErrorCode": "标准化错误码（OXN_ 前缀）"
    "Skill": "嵌入到 AI 助手的命令手册（.opencode/skills/）"
  }

  ban { "Flag", "Option", "Switch" }

  invariant { "所有错误码必须以 OXN_ 前缀（便于过滤）" }
  invariant { "AI 调用必须传 --json，CLI 默认 human 模式" }
  invariant { "子命令名使用 kebab-case" }
  invariant { "所有 .skill.md 模板由 src/skills/locales/* 自动编译，AI 助手里的副本是只读镜像" }

  context_map {
    imports "BuiltinContext" as "Builtin"
    imports "WorkContext" as "Work"
  }
}
