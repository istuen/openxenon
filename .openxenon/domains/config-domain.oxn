// Domain: config-domain
// Config 轴统一词汇（v0.1.3 引入）— 多 AI 助手 Skill 分发 + 物理配置边界
//
// 物理边界（IAP 范式）：
//   - 本域是「Config 轴」的 DDD 限界上下文：OXN 项目级的所有配置（含 .oxnrc / .openxenon/.config）
//   - 与 IntentDomain 通过 context_map 显式连接（不互相 include）
//   - 与 AlignDomain（work / task / .work）正交：本域管配置，彼域管编排
//
// 业务词汇（v0.1.3）— 4 大概念组（20 词）：
//   1. Skill 分发（4）：Skill / SkillAdapter / AdaptersRoot / MultiToolCompilation
//   2. Tool 决策（3）：EnabledAdapter / DisabledAdapter / DefaultAdapter
//   3. 配置 schema（6）：ConfigSchema / LeaderMode / ProjectConfig / ProjectBoundary
//                     / ProjectMode / ConfigMigration
//   4. Skill 资产（7）：SSOT / EmbeddedSkill / SkillLoader / SkillRenderer
//                     / SkillAdapterId / ReferenceFile / SkillContent

domain "config-domain" {
  description = "Config 轴统一词汇：OXN 项目级配置 + 多 AI 助手 Skill 分发配置；与 Intent/Align/Proof 三轴通过 IAP context_map 显式连接（不互相 include）"

  // ====================================================================
  // 术语（term 块单数：4 大组共 20 个）
  // ====================================================================

  term {
    // ───────── Skill 分发（4）─────────
    "Skill":                "OXN 内置的可分发资产，SSOT 在 src/skills/locales/；一次编译分发到多 AI 助手根目录"
    "SkillAdapter":         "目标 AI 助手适配器，描述如何把 Skill 写到该助手能识别的目录（含 opencode/claude/agents 三种）"
    "AdaptersRoot":         "SkillAdapter 写入的物理根目录（.opencode/skills/、.claude/skills/、.agents/skills/）；adapters 之间不重叠"
    "MultiToolCompilation": "一次 init 同时编译分发到多个 AdaptersRoot 的过程；compileAllSkills(toolIds, ...) 接口"

    // ───────── Tool 决策（3）─────────
    "EnabledAdapter":       "config.tools.enabled 显式白名单；resolveTools 时优先于其他来源"
    "DisabledAdapter":      "config.tools.disabled 黑名单；在无 enabled 时生效"
    "DefaultAdapter":       "未配置 tools 时 fallback 到 DEFAULT_ADAPTERS = [opencode, claude, agents]"

    // ───────── 配置 schema（6）─────────
    "ConfigSchema":         "OXN 配置的强类型 schema，分两层：OxnConfig（.oxnrc）+ ProjectConfig（.openxenon/.config）"
    "LeaderMode":           "CLI 路由模式，reference（双轨默认）/ mvp（单轨实验），存于 .oxnrc（git tracked）"
    "ProjectConfig":        "项目运行时配置，存于 .openxenon/.config（git ignored）；含 mode/locale/debug/tools 等"
    "ProjectBoundary":      "项目物理边界目录 .openxenon/；存放所有运行时与意图资产"
    "ProjectMode":          "PRODUCTION 或 SANDBOX 模式；与 leaderMode 正交"
    "ConfigMigration":      "配置路径的版本迁移（如 .openxenon/config.json → .openxenon/.config）；由 writeProjectConfig 触发原子 rename"

    // ───────── Skill 资产（7）─────────
    "SSOT":                 "Single Source of Truth：src/skills/locales/<locale>/<skill>/instruction.md；编译多份到各 AdaptersRoot"
    "EmbeddedSkill":        "Bun --compile 时打入二进制的 SKILL.md；通过 `import ... with { type: 'file' }` 引入"
    "SkillLoader":          "src/skills/loader.ts：getAllSkillsForLocale() / getSkillContent() 入口"
    "SkillRenderer":        "src/cli/skill-compiler.ts：defaultRender() 把 (name + description + instruction) 拼成 SKILL.md frontmatter"
    "SkillAdapterId":       "SkillAdapter 的字面 id 类型，'opencode' | 'claude' | 'agents'（DEFAULT_ADAPTERS as const）"
    "ReferenceFile":        "Skill 的引用资源（如 references/blueprint-format.md），通过 .references.hash 缓存"
    "SkillContent":         "{ instruction: string; references: ReferenceFile[] } 的运行时结构"
  }

  // ====================================================================
  // 禁词（ban 块单数：旧 v0.1.x 命名 / 跨轴词 / 易混淆词 = 11 个）
  // ====================================================================

  ban {
    // 旧 v0.1.x 命名（已删除的子命令）
    "install-skill-flag", "skillAdapterId", "adaptersDir",
    // 跨轴入侵（Align/Intent/Proof 词汇不该出现在 Config 域）
    "Work", "Task", "Blueprint", "Domain",
    // 易混淆词（应使用本域术语）
    "configFile", "rcFile", "dotFile", "settingsFile", "preferencesFile"
  }

  // ====================================================================
  // 不变量
  // ====================================================================

  // ───────── Skill 分发 ─────────
  invariant { "oxn init 默认同时把同一份 SSOT Skill 编译到 3 套 AdaptersRoot（opencode/claude/agents）" }
  invariant { "oxn init --tools <id> 是白名单；--without-tools <id> 是黑名单；--reset-tools 清空 config.tools" }
  invariant { "config.tools.{enabled,disabled} 解析优先级：CLI 白名单 > config.enabled > 黑名单 > DEFAULT_ADAPTERS" }
  invariant { "AdaptersRoot 互不重叠：opencode→.opencode/skills/；claude→.claude/skills/；agents→.agents/skills/" }
  invariant { "Claude Code 只识别 .claude/skills/（不读 .agents/skills/）；Cursor/Codex/Goose 共享 .agents/skills/" }

  // ───────── Config schema ─────────
  invariant { "OxnConfig（.oxnrc）只存 leaderMode；ProjectConfig（.openxenon/.config）存 mode/locale/debug/tools 等" }
  invariant { ".oxnrc git tracked（团队共享 leaderMode 偏好）；.openxenon/.config git ignored（个人运行时）" }
  invariant { "oxn config show 合并展示两套 schema 的当前值（leaderMode source + tools 行）" }
  invariant { "writeProjectConfig 触发 ConfigMigration：旧 .openxenon/config.json 自动 rename 到 .openxenon/.config" }
  invariant { "readProjectConfig 先试 .openxenon/.config，再 fallback .openxenon/config.json（双路径兜底，不写盘）" }

  // ───────── Skill 资产 ─────────
  invariant { "SSOT 唯一来源是 src/skills/locales/<locale>/<skill>/instruction.md（不在 oxn-cli/SKILL.md 直接编辑）" }
  invariant { "SKILL.md frontmatter 仅含 name + description（与 agentskills.io 标准子集对齐；不引入 disable-model-invocation 等扩展字段）" }
  invariant { "name 必须与目录名一致（^[a-z0-9]+(-[a-z0-9]+)*$），description ≤ 1024 字符" }
  invariant { "EmbeddedSkill 通过 `import ... with { type: 'file' }` 打入二进制；bun --compile 时路径替换为 $bunfs/..." }
  invariant { "defaultRender 输出字节级稳定；老项目重跑 init 时 hash 命中 skipped（保证零侵入升级）" }

  // ───────── 跨轴分工（与 Intent/Align/Proof/L0L3 的边界）─────────
  invariant { "本域管「OXN 自己用什么配置」；Intent 域管「OXN 做什么」（CLI/DSL/Program 三件套词汇）" }
  invariant { "本域管 Skill 分发；Align 域管 Skill 调用编排（work/task）" }
  invariant { "本域与 L0L3Context 正交：本域管业务配置 schema，L0L3 管代码分层架构" }
}
