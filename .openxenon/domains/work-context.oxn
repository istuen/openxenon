// Domain: WorkContext
// 任务执行（Work）限界上下文：管理 Work 沙盒、Artifact、Snapshot、Frozen
// v1.1 增：lock 边界守卫术语（PR-7/8/9/10）

domain "WorkContext" {
  description = "任务执行限界上下文 v1.1：管理 Work 沙盒与产物的全生命周期；包含 v1.1 lock 边界守卫（.work / planLock / 4 组件 hash）"

  term {
    "Work": "一次任务执行的沙盒，绑定一份 Blueprint"
    "Task": "Work 内的具体步骤，对齐 Blueprint 的某个 slot"
    "Artifact": "Work 执行产生的物理产物，被 Probe 观测的对象"
    "Snapshot": "某一时刻 Work 状态的不可变快照"
    "Frozen": "验证通过后生成的判决书（frozen.json）"
    "Trace": "Work 执行轨迹，JSONL 追加式事件流"
    "PartExecution": "单个 part 的执行记录（含 probe 结果）"
    "SkillContext": "AI 可见的目标/约束/当前焦点"

    // ───────── v1.1 Lock 边界守卫术语（与 IAPErrorContext 同步） ─────────
    "BirthCert":     "Work 的 .work 静态门禁卡：planLock + assets + context（goal/constraints/maxIterations）；写一次后只读"
    "PlanLock":      "BirthCert 内不可变快照：4 组件 hash（workOxn / workDomains / blueprints / tasks）+ allHash；锁后任何漂移 = LOCK_HASH_MISMATCH"
    "AssetHash":     "域/蓝图文件的 SHA-256（64-hex）：OXN 启动期算并存入 BirthCert.assets；validate 时重算，lock 时锁定"
    "WorkLayoutV0":  "V0 布局：works/<w>/work-state.json + tasks/<t>/task-state.json（无 .run/ 目录）"
    "WorkLayoutV1":  "V1 布局：works/<w>/.run/{state,trace,frozen}.{json,jsonl} + tasks/<t>/{state,trace,frozen}（PR-4+5 落地）"
    "MigratedV0Dir": "迁移备份目录：.migrated-v0/<rel> 保留 V0 原文件供审计；不删不自动清，留工程师手动清理"
  }

  ban { "Job", "TaskRun", "Execution", "Pipeline" }

  invariant { "Work 的运行时类型必须与 Blueprint.type 强一致" }
  invariant { "frozen.json 生成后不可修改（仅可读取作为判决书）" }
  invariant { "work-trace.jsonl 只能追加写，不能重写" }
  invariant { "同一 part 只能被提交一次，重复 submit 必须基于 freeze 重建" }
  invariant { "Artifact 路径必须落在 Work 沙盒内或宿主项目目录" }
  invariant { "Work 必须经过 validate → lock 才能 run/context（PR-8/9 守卫）；锁状态在 .work.planLock 静态卡中" }
  invariant { "lock 后任何 .oxn 资产漂移（域/蓝图文件改了、work.oxn 改了、task.oxn 改了）→ LOCK_HASH_MISMATCH（PR-8/9 守卫）" }
  invariant { "Work 必须存在 .run/state.json（V1 布局）；V0 布局必须先 oxn work migrate 才能走 lock 守卫（PR-10）" }
  invariant { "MigratedV0Dir 保留 V0 备份供审计；OXN 不自动清，工程师手动清理" }
}
