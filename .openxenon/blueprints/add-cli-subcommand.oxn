// .openxenon/blueprints/add-cli-subcommand.oxn
//
// 给 oxn CLI 增加新子命令的标准工作流
// 4 个 slot 按依赖顺序：analyze → design → implement → verify
//
// 用法：
//   oxn work create <work-id> --blueprint add-cli-subcommand
//   在 work context.goal 写明要加的子命令（具体业务落到 work 层）

blueprint "add-cli-subcommand" {
  version = 1
  description = "给 oxn CLI 增新子命令的技术流程：分析现有子命令布局 → 设计新子命令的协议与输出 → 实现子命令与测试 → 验证注册 + lint + test"

  prop "timeout" { type = number; default = 60000 }
  prop "strict" { type = boolean; default = true }

  slot "analyze-existing-cmds" {
    deps = []
    observe = ["fs-exists"]
    // 必读：src/cli/index.ts + src/cli/sub/<top>/index.ts
    // 产出：现有子命令的命名/参数/退出码惯例清单
  }

  slot "design-cmd-protocol" {
    deps = ["analyze-existing-cmds"]
    observe = ["fs-exists"]
    // 产出：子命令名 / 参数 / 输出 schema（JSON）/ 退出码（4 档分类器）
    // 必落文件（设计不是脑内活动）
  }

  slot "implement-cmd" {
    deps = ["design-cmd-protocol"]
    observe = ["lint-check", "ts-compiles"]
    // 实现：src/cli/sub/<top>/<cmd>/index.ts + 子命令注册到 src/cli/index.ts
  }

  slot "verify-registration" {
    deps = ["implement-cmd"]
    observe = ["test-pass"]
    // 验证：oxn <top> <cmd> --help 可用 + bun test 通过 + ESLint 架构守卫无新违规
  }
}
