// Blueprint: add-cli-subcommand — Generated by oxn sync-md v0.4 Phase 2
// synced at: 2026-06-26T01:19:20.323Z

blueprint "add-cli-subcommand" {
  version = 1
  description = "给 oxn CLI 增新子命令的技术流程：分析现有子命令布局 → 设计新子命令的协议与输出 → 实现子命令与测试 → 验证注册 + lint + test"
  prop "timeout" { type = number; default = 60000 }
  prop "strict" { type = boolean; default = true }

  slot "analyze-existing-cmds" {
    observe = ["fs-exists"]
  }
  slot "design-cmd-protocol" {
    deps = ["analyze-existing-cmds"]
    observe = ["fs-exists"]
  }
  slot "implement-cmd" {
    deps = ["design-cmd-protocol"]
    observe = ["lint-check", "ts-compiles"]
  }
  slot "verify-registration" {
    deps = ["implement-cmd"]
    observe = ["test-pass"]
  }
}
