// .openxenon/blueprints/dual-track.oxn
//
// 在 reference 架构上叠加 mvp leader 作为"旁路 canary" 的工作流
// 4 个 slot 按依赖顺序：branch → integrate → feature-flag → verify

blueprint "dual-track" {
  version = 1
  description = "从 reference 拉 explore/dual-track 分支，集成 mvp 的 leader 状态机作为旁路 (canary)，通过 OXN_LEADER_MODE 切换双路"

  prop "new_branch" { type = string; default = "explore/dual-track" }
  prop "from_branch" { type = string; default = "reference" }
  prop "leader_mode_env" { type = string; default = "OXN_LEADER_MODE" }

  slot "branch-from-reference" { }
  slot "integrate-mvp-leader" {
    deps = ["branch-from-reference"]
  }
  slot "wire-feature-flag" {
    deps = ["integrate-mvp-leader"]
  }
  slot "verify-dual-boot" {
    deps = ["wire-feature-flag"]
  }
}
