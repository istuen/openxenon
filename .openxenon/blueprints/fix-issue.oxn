// Blueprint: fix-issue — Generated by oxn sync-md v0.4 Phase 2
// synced at: 2026-06-26T01:19:20.301Z

blueprint "fix-issue" {
  version = 1
  description = "问题修复流程：诊断（带源码取证）→ 定位（带证据落盘）→ 修复（带回归）→ 验证（lint+typecheck+test 全过）"
  prop "timeout" { type = number; default = 60000 }
  prop "strict" { type = boolean; default = true }

  slot "diagnose" {
    observe = ["fs-content-match"]
  }
  slot "locate" {
    deps = ["diagnose"]
    observe = ["fs-exists"]
  }
  slot "fix" {
    deps = ["locate"]
    observe = ["ts-compiles", "test-pass"]
  }
  slot "verify" {
    deps = ["fix"]
    observe = ["lint-check", "ts-compiles", "test-pass"]
  }
}
