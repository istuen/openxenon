// Blueprint: doc-publish
//
// OpenXenon 产品文档站点（VitePress + GitHub Pages）发布流水线。
// 4 阶段：structure → content → build → deploy
//
// 入口（structure）必须 deps = []。
// DAG 线性，无环。
//
// 用途：被 `docs-site-v1.0` work 引用，对应 task 内的 4 个 part（structure/content/build/deploy）。
// 验证：`oxn blueprint validate doc-publish`

blueprint "doc-publish" {
  version = 1
  description = "OpenXenon 产品文档站点发布流水线：VitePress 站点结构 → 内容写入 → 静态构建 → GitHub Pages 部署"

  // 阶段 1：站点结构（VitePress 配置 + 目录布局 + i18n locales）
  // 产物：docs/.vitepress/config.ts + docs/public/index.html
  slot "structure" {
    deps = []
  }

  // 阶段 2：内容写入（md 章节、frontmatter、title、内链）
  // 产物：docs/zh-cn/*.md + docs/en/*.md + docs/examples/
  slot "content" {
    deps = ["structure"]
  }

  // 阶段 3：静态构建（bun run docs:build）
  // 产物：docs/.vitepress/dist/（含 index.html + 各 locale 的 .html）
  slot "build" {
    deps = ["content"]
  }

  // 阶段 4：部署（git push dev 触发 docs.yml → GitHub Pages）
  // 产物：https://istuen.github.io/openxenon/ 站点可访问
  slot "deploy" {
    deps = ["build"]
  }
}
