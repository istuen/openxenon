// Blueprint: git-workflow — Generated by oxn sync-md v0.4 Phase 2
// synced at: 2026-06-26T01:19:20.296Z

blueprint "git-workflow" {
  version = 1
  description = "Git workspace 隔离 + 质量门 + merge 可行性证据：3 阶段可被 Work 编排层选择性插入到任何主 Blueprint 的前后；OXN 只给证据，不替人决策"
  prop "strategy" { type = string; default = "none" }
  prop "base_branch" { type = string; default = "current" }
  prop "target_branch" { type = string; default = "current" }
  prop "worktree_root" { type = string; default = ".openxenon/_worktree" }

  slot "prepare-workspace" {
    observe = ["git-clean", "git-branch-exists"]
  }
  slot "precommit" {
    deps = ["prepare-workspace"]
    observe = ["shell-exec"]
  }
  slot "finalize" {
    deps = ["precommit"]
    observe = ["shell-exec", "git-status-clean", "git-merge-feasible"]
  }
}
