// .openxenon/blueprints/refactor-safe.oxn
//
// 结构性重构（重命名 / 提取 / 跨层搬迁）的标准工作流
// 拓扑：map-callers → extract → migrate-calls → verify
//
// 关键约束：
//   - L0–L3 宪法禁止跨层 import（kernel↔infra / kernel↔{cli,daemon} 等）
//   - 跨层搬迁必须先 map-callers 看清楚影响面
//   - 旧路径消失用 fs-not-exists 强制 verify
//
// 用法：
//   oxn work create refactor-<subject> --blueprint refactor-safe
//   在 work context.goal 写明：旧路径 / 新路径 / 受影响层（L0–L3）

blueprint "refactor-safe" {
  version = 1
  description = "结构性重构（重命名 / 提取 / 跨层搬迁）：先全量定位调用方 → 设计新结构 → 同步迁移调用 → 验证旧路径消失 + 架构守卫 + 全量回归"

  prop "old_path" { type = string; required = true }
  prop "new_path" { type = string; required = true }
  prop "layer" { type = string; default = "L2-Builtin" }

  slot "map-callers" {
    deps = []
    observe = ["fs-content-match", "fs-match"]
    // 全量定位所有 import / re-export / 字符串引用
    // 必产出：调用方清单（路径 + 行号 + 用途）
  }

  slot "extract" {
    deps = ["map-callers"]
    observe = ["fs-exists", "ts-compiles"]
    // 在新路径落新结构（保持旧 API 表面，或同时提供 adapter）
    // observe=ts-compiles 强制新结构类型完整
  }

  slot "migrate-calls" {
    deps = ["extract"]
    observe = ["fs-content-match"]
    // 改所有调用方到新路径
    // 严禁先删旧路径再迁移（commit 应保持绿）
  }

  slot "verify" {
    deps = ["migrate-calls"]
    observe = ["fs-not-exists", "lint-check", "ts-compiles", "test-pass"]
    // fs-not-exists: 旧路径/旧符号已消失
    // lint-check:    架构守卫（no-restricted-imports）无新违规
    // ts-compiles + test-pass: 类型 + 单测全过
  }
}
