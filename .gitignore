# ─────────────────────────────────────────────────────────────
# 1. 依赖与锁文件
# ─────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
pnpm-lock.yaml

# ─────────────────────────────────────────────────────────────
# 2. 构建产物
#    全局级兜底；具体子目录可在自己的 .gitignore 中再细化
# ─────────────────────────────────────────────────────────────
dist/
*.js
*.mjs
*.cjs
*.d.ts
*.d.ts.map
*.js.map
!.eslintrc.cjs
# 例外: 源码内的 .d.ts 类型声明是 build 输入, 需追踪
# (dist/ 产物已在 #2 ignore, bun run clean 不会误删)
!src/**/*.d.ts

# CLI 编译产物
xn
xn-*
*.exe

# ─────────────────────────────────────────────────────────────
# 3. 运行产物（CLI / DB / 日志 / 临时文件）
# ─────────────────────────────────────────────────────────────
*.db
*.db-journal
*.db-wal
*.db-shm

*.log
logs/

*.tmp
*.temp
.cache/
docs_tmp/

# ─────────────────────────────────────────────────────────────
# 4. 测试产物（全局兜底；tests/.gitignore 强化作用域）
# ─────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# VitePress 站点产物（docs/ 站点源在 git，build 产物不入仓）
docs/.vitepress/cache/
docs/.vitepress/dist/

# ─────────────────────────────────────────────────────────────
# 5. 环境与 IDE（OS / 编辑器 / 项目元数据）
# ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

.vscode/
.idea/
.kilocode/
.agents/
.claude/
*.swp
*.swo
*~

openspec/

# Forge 设计笔记（v0.1.0 发布后从 git 移除：内部设计文档不对外）
# 已通过 git rm --cached 从历史中移除（保留本地文件，停止追踪）
.openxenon/forges/

# 旧 docs 备份（M0 阶段安全网，手册完成后清理；不入仓）
docs-bak-2026-06/

# ─────────────────────────────────────────────────────────────
# 6. 业务运行时数据
#    实际规则已下沉到 .openxenon/.gitignore（domain/works/proof 等）
# ─────────────────────────────────────────────────────────────

# ts-compiles probe 临时 tsconfig（运行时写盘，跑完即删）
.tsconfig.oxn-*.json

# ─────────────────────────────────────────────────────────────
# 7. AI 工具个人配置 (.opencode/ .agents/ .claude/) — 个人配置不追踪
#    但 .opencode/skills/oxn-*/SKILL.md 等是产品资产
#    (CLI build 嵌入 + install-skill 复制), 需 un-ignore 具体文件
#    注: git 2.53 行为 — 父目录被 ignore 后, un-ignore 子文件需先 un-ignore 父目录链
# ─────────────────────────────────────────────────────────────
.opencode/
.agents/
.claude/
!.opencode/skills/
!.opencode/skills/oxn-cli/SKILL.md
!.opencode/skills/oxn-work/SKILL.md
!.opencode/skills/oxn-work/.references.hash
!.opencode/skills/oxn-work/references/blueprint-format.md
!.opencode/skills/oxn-proof/SKILL.md
