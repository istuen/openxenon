# ─────────────────────────────────────────────────────────────
# 1. 依赖与锁文件
# ─────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
pnpm-lock.yaml

# ─────────────────────────────────────────────────────────────
# 2. 构建产物
#    全局级兜底；具体子目录可在自己的 .gitignore 中再细化
# ─────────────────────────────────────────────────────────────
dist/
*.js
*.mjs
*.cjs
*.d.ts
*.d.ts.map
*.js.map
!.eslintrc.cjs
# 例外: 源码内的 .d.ts 类型声明是 build 输入, 需追踪
# (dist/ 产物已在 #2 ignore, bun run clean 不会误删)
!src/**/*.d.ts

# CLI 编译产物
xn
xn-*
*.exe

# ─────────────────────────────────────────────────────────────
# 3. 运行产物（CLI / DB / 日志 / 临时文件）
# ─────────────────────────────────────────────────────────────
*.db
*.db-journal
*.db-wal
*.db-shm

*.log
logs/

*.tmp
*.temp
.cache/
docs_tmp/

# ─────────────────────────────────────────────────────────────
# 4. 测试产物（全局兜底；tests/.gitignore 强化作用域）
# ─────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# VitePress 站点产物（docs/ 站点源在 git，build 产物不入仓）
docs/.vitepress/cache/
docs/.vitepress/dist/

# ─────────────────────────────────────────────────────────────
# 5. 环境与 IDE（OS / 编辑器 / 项目元数据）
# ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

.vscode/
.idea/
.kilocode/
.agents/
.claude/
*.swp
*.swo
*~

openspec/

# ─────────────────────────────────────────────────────────────
# 6. .openxenon/ 工程工作台 — git 规则
#    tracked（确定性）：docs/adrs/, docs/rfcs/, pools/drafts/, pools/issues/, pools/journals/, pools/spikes/
#    ignored（运行时）：works/, proofs/, .cache/, issues/, *-state.json, *-trace.jsonl, *-frozen.json
#    资产 assets/：默认 ignored（工程师按需注释对应行 opt-in tracked）
#    详见 .openxenon/.gitignore（运行时产物）与 .openxenon/pools/.gitignore
# ─────────────────────────────────────────────────────────────

# 运行时产物（始终 ignored）
.openxenon/works/
.openxenon/proofs/
.openxenon/.cache/
.openxenon/issues/
.openxenon/**/*-state.json
.openxenon/**/*-trace.jsonl
.openxenon/**/*-frozen.json
.openxenon/.work

# 资产（默认 ignored；工程师需 tracked 则注释掉下行）
.openxenon/assets/

# 开发性文档池（tracked）：docs/, pools/drafts/, pools/issues/, pools/journals/, pools/spikes/
# 仅 ignore 池内运行时产物
.openxenon/pools/**/*-state.json
.openxenon/pools/**/*-trace.jsonl
.openxenon/pools/**/*-frozen.json

# ts-compiles probe 临时 tsconfig（运行时写盘，跑完即删）
.tsconfig.oxn-*.json

# ─────────────────────────────────────────────────────────────
# 7. AI 工具个人配置 (.opencode/ .agents/ .claude/) — 个人配置不追踪
#    Skill 编译产物由 `oxn init` (skill-compile) 生成，不入库
#    本仓库所有 Skill 源在 packages/cli/src/skills/locales/
# ─────────────────────────────────────────────────────────────
.opencode/
.agents/
.claude/
logseq/
pages/

# Archived completed works
.openxenon/archived/works/*/

