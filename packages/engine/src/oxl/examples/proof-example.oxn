// Proof: shell-sanity (canonical v0.1 proof example — PARSEABLE)
// 验证 shell-exec + fs-exists + lint-check 三个 probe 都通过
//
// 物理边界：.openxenon/proofs/<name>/proof.oxn + frozen.json
// 由 `oxn proof create <name>` 生成，运行时 frozen.json 由 Core 产出（不可篡改）
//
// v0.1 canonical proof body 元素 (顺序不限):
//   - Description:         description = "..."
//   - ProofProbeDecl:      probe "name" { ref "BuiltinName", params { ... } }
//
// 注：Probe 在 Proof 中是"声明验收标准"（不实际执行），由 Core 在 work run 阶段调用
//     verdict 三态: pass / fail / inconclusive 在 frozen.json.verdict 字段
//     （proof.oxn 只声明 probe 期望；运行时 verdict 由 Core Engine 评判）

proof "shell-sanity" {
  description = "Sanity check: shell-exec + fs-exists + lint-check 三个 probe 都必须 PASS（verdict=pass）"

  probe "shell_exec_check" {
    ref "ShellExec"
    params { "command" = "echo hello && exit 0" }
  }

  probe "fs_exists_check" {
    ref "FsExists"
    params { pattern = "**/package.json" }
  }

  probe "lint_check" {
    ref "LintCheck"
    params { "command" = "bun run lint" }
  }
}