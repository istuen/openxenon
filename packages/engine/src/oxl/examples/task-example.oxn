// Task: explore-dsl (canonical v0.1 task example — PARSEABLE)
// 注入 dsl-context，绑 explore-analyze-report
// 跑遍 blueprint 的 3 个 slot: explore / analyze / report
//
// 物理边界：.openxenon/works/<work>/tasks/<task>/task.oxn
// 由 `oxn work add-task --task <name> --blueprint <bp> [--domain <dn>]` 生成
//
// v0.1 canonical task body 元素 (顺序不限):
//   - TaskDomainField:     domain "X"
//   - TaskBlueprintField:  blueprint "Y"
//   - TaskPartDecl:        part "name" { skill_context, probe }
//   - TaskDepsField:       deps = [...]  /  deps : [...]  /  deps = "x"
//
// 注意：task body 不允许 inject / context / slot
// （这些是 skill 语义层概念，由 work.oxn 持有）

task "explore-dsl" {
  domain "DSLContext"
  blueprint "explore-analyze-report"

  part "explore" {
    skill_context = "探索 OXL grammar/schema/validator/compiler 四个子模块"
    probe "shell_exec_grammar" {
      ref "ShellExec"
      params = { command = "oxn dev compile --grammar", timeout = 60000 }
    }
  }

  deps = []
}