// Blueprint: oxn-example (canonical v0.1 blueprint example — PARSEABLE)
// 示例 Blueprint，展示 v0.1-final DSL 语法
//
// 物理边界：.openxenon/blueprints/<name>.oxn
// 由 `oxn blueprint create <name>` 生成；运行时由 `oxn blueprint compile <name>` 生成对应 .md 视图
//
// v0.1 canonical blueprint body 元素 (顺序固定):
//   1. ('version' '=' version=NUMBER)?
//   2. (descriptions+=Description)*
//   3. (props+=PropDeclaration)*
//   4. (partSlots+=PartSlotDeclaration)*
//
// slot 内:
//   - ('deps' '=' '[' ... ']')?
//   - (observe+=ObserveDeclaration)?  // observe = ["ProbeName1", "ProbeName2"]
//
// prop 内（顺序固定: type → required → default）:
//   - 'type' '=' type=TypeReference ';'
//   - ('required' '=' value=BooleanLiteral ';'?)?
//   - ('default' '=' value=Expression ';'?)?

blueprint "oxn-example" {
  version = 1
  description = "示例 Blueprint：build → { develop, test } → verify 拓扑"

  prop "env" { type = string; default = "dev" }
  prop "timeout" { type = number; required = true; default = 60000 }

  slot "build" {
    deps = []
  }

  slot "develop" {
    deps = ["build"]
  }

  slot "test" {
    deps = ["build"]
    observe = ["ShellExec", "LintCheck"]
  }

  slot "verify" {
    deps = ["develop", "test"]
    observe = ["LintCheck", "TsCompiles", "TestPass"]
  }
}