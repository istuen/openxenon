// Task: register-member
// 注入 member-context，绑 dev-workflow
// 跑遍 blueprint 的 3 个 slot: develop / test / verify

task "register-member" blueprint "dev-workflow" {
  inject "member-context";

  context {
    objective = "实现 Member 注册逻辑：接收 username/email/password，生成 Member 实体，hash 密码后存储";
    constraints = [
      "类名必须是 Member (noun)",
      "禁用 User/Customer/AccountHolder (ban 列表)",
      "必须 hash 密码 (rule.PasswordNeverPlaintext)"
    ];
  }

  slot "develop" {
    deps = [];
  }

  slot "test" {
    deps = ["develop"];
  }

  slot "verify" {
    deps = ["test"];
  }
}
