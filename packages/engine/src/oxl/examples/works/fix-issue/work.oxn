// Work: fix-issue
// 修复类工作流：诊断问题现象、定位根本原因、实施修复方案、验证修复结果

work "fix-issue" {
  context {
    goal = "修复 work state 在 submit 后未及时持久化的 bug";
    constraints = [
      "不破坏现有 leader 状态机",
      "frozen.json 路径不能改",
      "必须经 vitest 验证"
    ];
    loop_policy {
      max_iterations = 5;
    }
  }

  domain "WorkContext" ref "@prj/domains/work-context";
  blueprint "fix-issue" ref "@prj/blueprints/fix-issue";

  task "diagnose" {
    domain "WorkContext";
    blueprint "fix-issue";
    part "diagnose" {
      skill_context = "复现 bug，记录现场";
    }
    deps = [];
  }

  task "locate" {
    domain "WorkContext";
    blueprint "fix-issue";
    part "locate" {
      skill_context = "定位根本原因";
    }
    deps = ["diagnose"];
  }

  task "fix" {
    domain "WorkContext";
    blueprint "fix-issue";
    part "fix" {
      skill_context = "实施修复方案";
    }
    deps = ["locate"];
  }

  task "verify" {
    domain "WorkContext";
    blueprint "fix-issue";
    part "verify" {
      skill_context = "验证修复结果";
    }
    deps = ["fix"];
  }
}
