// Work: example-work (canonical v0.1 work example — PARSEABLE)
// 示例 Work：演示 v0.1-final canonical Work 语法
//
// 物理边界：.openxenon/works/<name>/work.oxn
// 由 `oxn work create <name> --blueprint <bp>` 生成
//
// v0.1 canonical work body 元素 (顺序不限, 可选):
//   - WorkContext:        context { goal; constraints; loop_policy { ... } }
//   - DomainRefDecl:      domain "X" ('as' alias)? ('ref' ref)? ';'
//   - BlueprintRefDecl:   blueprint "Y" ('as' alias)? ('ref' ref)? ';'
//   - PartRefDecl:        part "Z" ('as' alias)? ('ref' ref)? ';'
//   - ProbeRefDecl:       probe "..." ('as' alias)? ('ref' ref)? ';'
//   - DomProofRef:        proofs '[' (entries+=STRING (',' entries+=STRING)*)? ']' ';'?
//   - TaskDeclaration:    task "name" { ... } (no trailing ';' inside task body)

work "example-work" {
  context {
    goal = "示例 Work：演示 canonical v0.1 Work 语法";
    constraints = [
      "使用 oxn 命令而非直接读源码",
      "输出报告到 .openxenon/works/example-work/report.md"
    ];
    loop_policy {
      max_iterations = 3;
    }
  }

  domain "ExampleDomain" ref "@prj/domains/example-domain";
  blueprint "oxn-example" ref "@prj/blueprints/oxn-example";

  task "example-task" {
    domain "ExampleDomain"
    blueprint "oxn-example"
    part "build" {
      skill_context = "构建产物"
    }
    deps = []
  }
}