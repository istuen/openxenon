// Probe: shell_exec / fs_exists (canonical v0.1 probe example — PARSEABLE)
// 示例 Probe：演示 v0.1 canonical Probe 语法（独立资产定义）
//
// 物理边界：.openxenon/probes/<name>/probe.oxn
// 由 `oxn probe add <name>` 生成
//
// 注：Probe 在 Blueprint slot.observe / Part.observe / Proof.probe 中被引用
//    14 个 builtin probe (fs-exists / fs-content-match / shell-exec / git-clean /
//      git-branch-exists / git-status-clean / git-merge-feasible / test-pass /
//      ts-compiles / lint-check / deps-resolved / http-responds / file-exports)
//    已在 src/builtin/probes/ 中定义（不需要 .oxn 源文件）
//
// v0.1 canonical Probe body 元素 (顺序不限, 可选):
//   - ('scheme' ':' scheme=STRING)?          // scheme = "shell" / "fs" / "git" / "http"
//   - (descriptions+=Description)?
//   - (props+=PropDeclaration)*
//   - (output+=ProbeOutputDeclaration)?

probe "shell_exec" {
  scheme: "shell"
  description = "执行 shell 命令并返回结果"
  prop "command" { type = string; required = true }
  prop "timeout" { type = number; default = 60000 }
  output { exit_code = number; stdout = string; stderr = string }
}

probe "fs_exists" {
  scheme: "fs"
  description = "检查指定 glob 模式的文件是否存在"
  prop "pattern" { type = string; required = true }
  output { exists = boolean }
}