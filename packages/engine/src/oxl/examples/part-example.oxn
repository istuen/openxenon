// Part: develop (canonical v0.1 part example — PARSEABLE)
// 示例 Part：演示 v0.1-final canonical Part 语法
//
// 物理边界：.openxenon/parts/<name>/part.oxn（独立资产定义）
// 由 `oxn part create <name>` 生成
//
// 注：Part 在 v0.1 是独立资产定义；但 v1.1 改革后 Part **内联到 task 内**（task.part）
//      这个独立 .oxn 文件主要给「全局目录」+「跨 work 复用」的场景使用
//      本例保留以展示 v0.1 standalone Part 语法
//
// v0.1 canonical Part body 元素 (顺序不限, 可选):
//   - Description:           description = "..."
//   - PartSkill:             skill { lifecycle, objective, acceptance }
//   - PropDeclaration:       prop "name" { type, required, default }
//   - PartProbeDeclaration:  probe <id> align "RefName" ref "BuiltinName" { params }
//   - ObserveDeclaration:    observe = ["ProbeName1", "ProbeName2"]
//   - ExecutionRef array:    execution = [Probe1, Probe2]  (cross-ref via ID)

part "develop" {
  description = "示例 Part：开发新功能的 AI 操作单元"

  skill {
    lifecycle = "implement";
    objective = "实现 feature_desc 描述的新功能";
    acceptance = ["代码通过 bun run typecheck", "代码通过 bun run lint"];
  }

  prop "feature_desc" { type = string; required = true }
  prop "timeout" { type = number; default = 60000 }

  probe dev_compile align "Compile" ref "ShellExec" {
    params = { "command" = "bun run typecheck" }
  }
  probe dev_lint align "Lint" ref "ShellExec" {
    params = { "command" = "bun run lint" }
  }

  observe = ["ShellExec", "LintCheck", "TsCompiles"]

  execution = [dev_compile, dev_lint]
}