{
  "name": "@istuen/openxenon",
  "version": "0.6.4-alpha.0",
  "description": "OpenXenon — 工程师与 AI 协作工作台（v0.6 Monorepo 双包：CLI + Engine）",
  "author": "istuen",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "./dist/cli.js",
  "bin": {
    "oxn": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun run packages/cli/src/index.ts",
    "build:dist": "bun build ./packages/cli/src/index.ts --target=node --outdir dist --entry-naming cli.js --banner='#!/usr/bin/env node'",
    "build:clean": "rm -rf dist",
    "build": "bun run build:clean && bun run build:dist",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "eslint src/ packages/",
    "lint:fix": "eslint src/ packages/ --fix",
    "format": "biome format --write src/ packages/",
    "format:check": "biome format src/ packages/",
    "check": "biome check src/ packages/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules",
    "oxn:dev": "bash scripts/oxn-switch.sh dev",
    "oxn:prod": "bash scripts/oxn-switch.sh prod",
    "oxn:status": "bash scripts/oxn-switch.sh status",
    "prepare": "lefthook install",
    "prepublishOnly": "bun run prepublish:check && bun run build",
    "prepublish:check": "bun run typecheck && bun run lint && bun test",
    "version:check": "bun run scripts/version-check.ts",
    "version:sync": "bun run scripts/version-sync.ts",
    "version:aggregate": "bun run scripts/version-aggregate.ts",
    "check:naming": "bun run scripts/check-naming.ts",
    "check:heading-skeleton": "bun scripts/check-heading-skeleton.ts .openxenon/drafts/",
    "check:mdast": "bun run scripts/parse-mdast.ts",
    "check:md-canonical": "bun scripts/check-md-canonical.ts .openxenon/drafts/",
    "check:md-fallback": "bun run scripts/check-md-fallback-stats.ts",
    "check:intent-types-drift": "bun scripts/check-intent-types-drift.ts",
    "check:no-langium": "bun scripts/check-no-new-langium-usage.ts",
    "check:adr-landing": "bun scripts/check-adr-landing.ts",
    "check:adr-landing:strict": "bun scripts/check-adr-landing.ts --strict",
    "check:adr-landing:enforce": "bun scripts/check-adr-landing.ts --enforce",
    "check:asset-structure": "bun scripts/check-asset-structure.ts",
    "check:versioned-docs": "bun scripts/check-versioned-docs.ts",
    "check:all": "bun run check:asset-structure && bun run check:naming && bun run check:md-canonical && bun run check:heading-skeleton && bun run check:md-fallback && bun run check:intent-types-drift && bun run check:no-langium && bun run check:adr-landing && bun run check:versioned-docs && bun run docs:boundary",
    "docs:boundary": "bun scripts/check-doc-boundary.ts",
    "docs:dev": "pnpm --filter @openxenon/docs dev",
    "docs:build": "pnpm --filter @openxenon/docs build",
    "docs:preview": "pnpm --filter @openxenon/docs preview"
  },
  "dependencies": {
    "citty": "^0.1.6",
    "glob": "^13.0.6",
    "i18next": "^26.3.2",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-markdown": "^2.1.2",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "which": "^2.0.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/mdast": "^4.0.4",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "bun-types": "^1.3.14",
    "eslint": "^10.5.0",
    "lefthook": "^2.1.9",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cli",
    "ai",
    "llm",
    "engineering",
    "automation",
    "verification",
    "oxl",
    "openxenon-language"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/istuen/openxenon.git"
  },
  "bugs": {
    "url": "https://github.com/istuen/openxenon/issues"
  },
  "homepage": "https://github.com/istuen/openxenon#readme",
  "packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977"
}
