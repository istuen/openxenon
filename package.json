{
  "name": "@istuen/openxenon",
  "version": "0.4.0",
  "description": "OpenXenon — 工程师与 AI 协作工作台（v0.6 Monorepo 双包：CLI + Engine）",
  "author": "istuen",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "./dist/cli.js",
  "bin": {
    "oxn": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "langium:generate": "langium generate",
    "build:dist": "bun build ./src/cli/index.ts --target=node --outdir dist --entry-naming cli.js --banner='#!/usr/bin/env node'",
    "build:clean": "rm -rf dist",
    "build": "bun run build:clean && bun run langium:generate && bun run build:dist",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "eslint src/ packages/",
    "lint:fix": "eslint src/ packages/ --fix",
    "format": "biome format --write src/ packages/",
    "format:check": "biome format src/ packages/",
    "check": "biome check src/ packages/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules",
    "prepare": "lefthook install",
    "prepublishOnly": "bun run prepublish:check && bun run build",
    "prepublish:check": "bun run typecheck && bun run lint && bun test",
    "version:check": "bun run scripts/version-check.ts",
    "version:sync": "bun run scripts/version-sync.ts",
    "version:aggregate": "bun run scripts/version-aggregate.ts",
    "check:naming": "bun run scripts/check-naming.ts",
    "check:mdast": "bun run scripts/parse-mdast.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "citty": "^0.1.6",
    "glob": "^13.0.6",
    "i18next": "^26.3.2",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-markdown": "^2.1.2",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "which": "^2.0.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "bun-types": "^1.3.14",
    "eslint": "^10.5.0",
    "langium": "^4.3.0",
    "langium-cli": "^4.3.0",
    "lefthook": "^2.1.9",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cli",
    "ai",
    "llm",
    "engineering",
    "automation",
    "verification",
    "oxl",
    "openxenon-language"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/istuen/openxenon.git"
  },
  "bugs": {
    "url": "https://github.com/istuen/openxenon/issues"
  },
  "homepage": "https://github.com/istuen/openxenon#readme"
}
