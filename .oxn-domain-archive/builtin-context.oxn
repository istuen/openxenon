// Domain: BuiltinContext
// 内置（Builtin）限界上下文：管理 OXN 内置探针与零件（@oxn 作用域）的概念边界

domain "BuiltinContext" {
  description = "内置限界上下文：管理 OXN 自带的 @oxn 作用域探针（probe）与零件（part），定义其语义边界"

  term {
    "Probe": "OXN 内置探针，物理观测 + 纯函数判定（fs-exists / shell-exec 等）"
    "Part": "OXN 内置零件，封装可复用的工程动作（git-commit / create-branch 等）"
    "Builtin": "OXN 自带资产，存放在 src/builtin/ 目录的 .oxn 文件中"
    "Scope": "OXN 引用作用域，@oxn 指向内置，@prj 指向项目"
    "Registry": "内存中的 @oxn 资产查询表，由 OxnBuiltinRegistry 维护"
  }

  ban { "Resource", "Template", "Config", "Definition", "GlobalAsset" }

  invariant { "Builtin 探针类型必须是 fs_exists / fs_not_exists / fs_match / shell_exec 之一" }
  invariant { "Builtin 资产版本 (_version) 单调递增，不可降级" }
  invariant { "Builtin 资产不依赖任何 @prj 资产（避免循环引用）" }
}
