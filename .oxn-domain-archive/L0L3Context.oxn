// Domain: L0L3Context
// OpenXenon 元域（Meta-Domain）— L0-L3 四层架构与依赖宪法的业务限界上下文
//
// 用法：当 AI 协助重构架构、修改跨层依赖、命名新模块时，引用此 Domain 约束术语。
// 注意：本文档是"用户业务域"中关于 OXN 元域的投影，与
//       docs/architecture/l0-l3-constitution.md（OXN 元域聚合根）通过上下文映射连接。
//
// 详细分层定义与依赖规则见 docs/architecture/l0-l3-constitution.md。

domain "L0L3Context" {
  description = "OpenXenon 元域限界上下文：约束 L0-L3 四层架构的核心词汇、禁用词与业务不变量"

  // ─── 核心实体（AI 写代码时必须使用这些词）───
  term {
    "Layer": "四层之一（L0/L1/L2/L3），描述代码在 src/ 树中的物理归属与依赖方向"
    "SubLayer": "八子层之一（Schema/Contract/Processor/Infra/OXN-DSL/Builtin/Work/CLI），是 CI validate-deps 的最小校验单位"
    "Kernel": "L0 核心真空层，纯函数零 IO，包含 Schema/Contract/Processor 三个子层"
    "Foundation": "L1 基础设施层，DSL 解析（OXN DSL）+ 物理 IO 收口（Infra）"
    "Module": "L2 业务/工程模块层，包含 Builtin（资产）+ Work（运行时）"
    "Runtime": "L3 入口/外部交互层，包含 CLI/Daemon/Hall/Skill/Watcher/Core/i18n"
    "Port": "L1 物理 IO 收口接口（FsPort/PathPort/ProbePort/HashPort/OsPort/PartPort）"
    "Builtin": "L2 编译后的二进制内置资产，位于 src/builtin/"
    "ContextMap": "跨域引用声明（DDD 术语），唯一允许的跨边界依赖方式"
    "Constitution": "OXN 元域的聚合根文档，即 docs/architecture/l0-l3-constitution.md"
    "Violation": "违反 L0-L3 依赖规则的跨层引用，被 CI validate-deps.yml 自动拦截"
  }

  // ─── 禁用词（避免术语漂移与跨上下文混淆）───
  ban { "L2Domain", "Tier", "TierLevel", "Stratum", "Strata", "ArsenalPromote", "DraftAsset", "CanonicalAsset" }

  // ─── 业务不变量（架构硬规则，AI 不得违反）───

  // ── 内层不依赖外层 ──
  invariant { "L0 Kernel 不得 import 任何 L1+ 模块（src/kernel/ 内不出现 oxn-dsl/infra/builtin/work/cli/daemon/hall/skills/watcher/core/i18n 引用）" }
  invariant { "L1 Foundation 不得 import L2/L3 模块" }
  invariant { "L2 Module 不得 import L3 Runtime 模块" }
  invariant { "L3 Runtime 允许 import 所有下层（入口层的特权）" }

  // ── L0 纯逻辑约束 ──
  invariant { "L0 Kernel 不得使用 fs / path / crypto / http / child_process / os / net 等平台 IO 模块" }
  invariant { "L0 Kernel 不得访问 process.env / process.stdout / process.stdin" }
  invariant { "L0 Kernel 不得使用 EventEmitter 或维护运行时状态" }

  // ── 命名约束 ──
  invariant { "L2 层命名为 Module 而非 Domain（避免与 OXN DSL 的 Domain 实体产生歧义，参见 ADR-0006）" }
  invariant { "L0-L3 与 P0-P3 是两个正交概念：L0-L3 描述代码分层，P0-P3 描述产品路线图" }

  // ── 跨域隔离 ──
  invariant { "Domain 实体（用户业务域）与 L0-L3 宪法（OXN 元域）通过 context_map 显式连接，不可互相包含" }
  invariant { "OXN 元域的宪法文档（l0-l3-constitution.md）不在用户业务域的文档体系内" }
}
